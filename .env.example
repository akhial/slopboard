# Slopboard settings. Copy to deploy/.env and fill in; that file is not committed.
#
#   cp .env.example deploy/.env
#
# deploy/compose.yaml reads deploy/.env for both services. Keep it there and
# not in the repository root: Bun loads a .env from the working directory, so a
# root .env would hand production secrets to `bun test` and the dev server.
# For development, export the variables you need in your shell instead.

# --- Postgres -------------------------------------------------------------

# Password of the "slopboard" superuser the db container is created with.
# Only read the first time the data volume is initialised.
POSTGRES_PASSWORD=change-me

# Read-write connection of the app: the same password as above.
# Inside compose the host is "db". Special characters must be URL-encoded.
DATABASE_URL=postgres://slopboard:change-me@db:5432/slopboard

# Connection of the read-only role behind POST /api/sql. The app creates the
# role named here at boot and repairs it on every boot: password, SELECT on
# everything and nothing else, no temporary tables, no advisory locks, its
# settings reset. Use a different password than above.
# Leave empty to switch POST /api/sql off.
DATABASE_RO_URL=postgres://slopboard_ro:change-me-too@db:5432/slopboard

# --- The proxy (CLIProxyAPI) -----------------------------------------------

# Where the proxy is reachable from the app container. Required: without it
# nothing is collected and the key CLI refuses to run.
PROXY_URL=http://cli-proxy-api:8317

# The proxy's management key: the plaintext of management.secret-key in its
# config, or its MANAGEMENT_PASSWORD. Used to pull usage records and, by the
# key CLI, to edit the list of client API keys.
PROXY_MANAGEMENT_KEY=

# --- Board -----------------------------------------------------------------

# IANA time zone that decides what "today", a day and an hour are.
BOARD_TZ=UTC

# Port to listen on when running outside Docker. Inside deploy/compose.yaml the
# container always listens on 8318; PUBLISH below decides where that appears.
PORT=8318

# Milliseconds between polls of the proxy's usage queue. The proxy keeps
# records for at most redis-usage-queue-retention-seconds (set it to 3600).
POLL_INTERVAL_MS=2000

# --- deploy/compose.yaml only ------------------------------------------------

# Host address and port the board is published on.
# PUBLISH=127.0.0.1:8318

# Docker network the proxy's containers are on, which the app joins to reach
# PROXY_URL. `docker network ls` shows it; it is usually <proxy project>_default.
# PROXY_NETWORK=cliproxyapi_default

# --- Optional, shown with their defaults -----------------------------------

# HOST=0.0.0.0                # address to listen on outside Docker
# NODE_ENV=                   # "production" serves the UI minified and cached; the image sets it
# COLLECTOR_ENABLED=true      # false: serve the board without pulling from the proxy
# POLL_BATCH=500              # records asked from the proxy per poll
# MAX_PENDING=50000           # records held in memory while Postgres is down
# BOARD_CACHE_MS=5000         # how long a built board is reused
# SQL_TIMEOUT_MS=5000         # statement timeout of POST /api/sql
# SQL_MAX_ROWS=1000           # row cap of POST /api/sql
# SQL_MAX_BYTES=4000000       # size cap of one POST /api/sql result
# PRICES_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# PRICES_REFRESH_HOURS=24     # how often the price list is downloaded again
